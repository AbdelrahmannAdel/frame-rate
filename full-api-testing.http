%}


### 5.8 GET a review/movie/user that doesn't exist — 404
GET http://localhost:8080/movies/999999

> {%
client.test("404 not found", function() { client.assert(response.status === 404, "got " + response.status); });
%}


### =========================================================
### PART 6 — FOLLOW + COMPATIBILITY FEATURE, FULL FLOW
### =========================================================

### 6.1 A follows B
POST http://localhost:8080/users/following
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "followeeId": {{userIdB}}
}

> {%
client.test("201", function() { client.assert(response.status === 201); });
%}


### 6.2 Compatibility check BEFORE mutual follow — 403 NotMutualFollowException
GET http://localhost:8080/users/compatibility/{{userIdB}}
Authorization: Bearer {{tokenA}}

> {%
client.test("403 not mutual yet", function() { client.assert(response.status === 403, "got " + response.status); });
%}


### 6.3 B follows A back (now mutual)
POST http://localhost:8080/users/following
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "followeeId": {{userIdA}}
}

> {%
client.test("201", function() { client.assert(response.status === 201); });
%}


### 6.4 A tries to follow B again — 409 duplicate follow
POST http://localhost:8080/users/following
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "followeeId": {{userIdB}}
}

> {%
client.test("409 duplicate follow", function() { client.assert(response.status === 409, "got " + response.status); });
%}


### 6.5 Compatibility check, A's perspective — real score now
### A rated 8 (after the 4.4 update), B rated 6 -> |8-6|=2 -> 100-(2/9*100) ≈ 77.8%
GET http://localhost:8080/users/compatibility/{{userIdB}}
Authorization: Bearer {{tokenA}}

> {%
client.test("200 + real score + 1 shared movie", function() {
    client.assert(response.status === 200);
    client.assert(response.body.compatibilityScore !== null);
    client.assert(response.body.sharedMovies.length === 1);
    console.log("compatibility score: " + response.body.compatibilityScore);
});
%}


### 6.6 Compatibility, B's perspective — should mirror 6.5 with ratings swapped
GET http://localhost:8080/users/compatibility/{{userIdA}}
Authorization: Bearer {{tokenB}}

> {%
client.test("200 + mirrored", function() {
    client.assert(response.status === 200);
    client.assert(response.body.sharedMovies[0].myRating === 6);
    client.assert(response.body.sharedMovies[0].theirRating === 8);
});
%}


### 6.7 Compatibility against C, who nobody follows — 403
GET http://localhost:8080/users/compatibility/{{userIdC}}
Authorization: Bearer {{tokenA}}

> {%
client.test("403 not mutual", function() { client.assert(response.status === 403); });
%}


### 6.8 A follows D
POST http://localhost:8080/users/following
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "followeeId": {{userIdD}}
}


### 6.9 D follows A back (mutual, but zero shared reviews)
POST http://localhost:8080/users/following
Content-Type: application/json
Authorization: Bearer {{tokenD}}

{
  "followeeId": {{userIdA}}
}


### 6.10 Compatibility A vs D — zero shared movies -> null score, NOT 0%, NOT an error
GET http://localhost:8080/users/compatibility/{{userIdD}}
Authorization: Bearer {{tokenA}}

> {%
client.test("200 + null score + empty sharedMovies (not an error, not 0%)", function() {
    client.assert(response.status === 200);
    client.assert(response.body.compatibilityScore === null, "got: " + response.body.compatibilityScore);
    client.assert(response.body.sharedMovies.length === 0);
});
%}


### 6.11 GET /users/{id}/following now reflects real data
GET http://localhost:8080/users/{{userIdA}}/following

> {%
client.test("A follows 2 people now (B and D)", function() {
    client.assert(response.body.length === 2, "got " + response.body.length);
});
%}


### 6.12 A unfollows B
DELETE http://localhost:8080/users/following/{{userIdB}}
Authorization: Bearer {{tokenA}}

> {%
client.test("200 + deleted:true", function() {
    client.assert(response.status === 200);
    client.assert(response.body.deleted === true);
});
%}


### 6.13 Compatibility now broken (no longer mutual) — 403 again
GET http://localhost:8080/users/compatibility/{{userIdB}}
Authorization: Bearer {{tokenA}}

> {%
client.test("403 after unfollow", function() { client.assert(response.status === 403); });
%}


