POST http://localhost:8080/movies/{{movieId}}/reviews
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "rating": 3
}

> {%
client.test("409 duplicate review", function() { client.assert(response.status === 409, "got " + response.status); });
%}


### 5.7 A tries to delete B's review — should be UnauthorizedActionException (403)
DELETE http://localhost:8080/movies/{{movieId}}/reviews/{{reviewIdB}}
Authorization: Bearer {{tokenA}}

> {%
