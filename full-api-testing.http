### =========================================================
### PART 5 — VALIDATION / DUPLICATE / OWNERSHIP ERROR PATHS
### =========================================================

### 5.1 Duplicate username on register — 409
POST http://localhost:8080/users
Content-Type: application/json

{
  "username": "alice_v3_renamed",
  "email": "someoneelse_v3@example.com",
  "password": "password123"
}

> {%
client.test("409 duplicate username", function() { client.assert(response.status === 409, "got " + response.status); });
%}


### 5.2 Duplicate email on register — 409
POST http://localhost:8080/users
Content-Type: application/json

{
  "username": "brandnew_v3",
  "email": "bob_v3@example.com",
  "password": "password123"
}

> {%
client.test("409 duplicate email", function() { client.assert(response.status === 409); });
%}


### 5.3 Self-follow — 400
POST http://localhost:8080/users/following
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "followeeId": {{userIdA}}
}

> {%
client.test("400 self-follow", function() { client.assert(response.status === 400, "got " + response.status); });
%}


### 5.4 Invalid rating (out of 1-10 range) — 400
POST http://localhost:8080/movies/{{movieId}}/reviews
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "rating": 99
}

> {%
client.test("400 invalid rating", function() { client.assert(response.status === 400, "got " + response.status); });
%}


